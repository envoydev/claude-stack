{
  "name": "claude-stack",
  "owner": {
    "name": "envoydev",
    "url": "https://github.com/envoydev"
  },
  "metadata": {
    "description": "Claude Code agent stack - skills, agents, rules, hooks, and MCP servers, installed and updated via the claude-stack plugin.",
    "version": "0.2.87"
  },
  "allowCrossMarketplaceDependenciesOn": [
    "claude-plugins-official"
  ],
  "plugins": [
    {
      "name": "claude-stack",
      "source": "./setup-plugin",
      "description": "The Claude Code stack, guided: setup (fresh install from scratch) + update (refresh + prune upstream removals) + configure (adjust the selection) + validate (reconcile to the project) + status (read-only per-area inventory), all selection-driven with prerequisite checks.",
      "category": "development",
      "tags": [
        "setup",
        "installer",
        "skills",
        "agents",
        "mcp",
        "bootstrap"
      ]
    },
    {
      "name": "claude-stack-hooks",
      "source": "./",
      "description": "The thirteen claude-stack hooks, wired inline: the deterministic gates (force-push, catastrophic rm, whole-file reads, credential reads, ungated dispatch and commit, cross-project writes, the stop contract, the answer budget, the fresh-session offer) plus the docs and memory session engines.",
      "version": "0.2.87",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-protected-force-push.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-catastrophic-rm.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-read-whole-file.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-ungated-commit.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Read",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-read-whole-file.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Grep",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Task|Agent",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-unapproved-dispatch.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-cross-project-write.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Glob",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": ".*",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/instrument-tool-usage.js",
                "timeout": 10
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js",
                "timeout": 10
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js",
                "timeout": 10
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js",
                "timeout": 10
              }
            ]
          },
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/memory-session.js",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js",
                "timeout": 10
              }
            ]
          }
        ]
      },
      "dependencies": [
        "claude-stack"
      ]
    }
  ]
}
