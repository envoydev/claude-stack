{
  "description": "The guided walks' layer ask must follow the pasted stack-select table.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-layer-table.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
